{
  "name": "agencys-content-studio",
  "private": true,
  "version": "0.2.0",
  "description": "个人内容创作平台：模板化流水线 + 统一资产 + 供应商适配层（本地单机 Web）",
  "packageManager": "pnpm@12.3.4",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @acs/server --filter @acs/web dev",
    "dev:server": "pnpm --filter @acs/server dev",
    "dev:web": "pnpm --filter @acs/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "format:check": "pnpm --filter @acs/web format:check",
    "check:comments": "pnpm --filter @acs/server check:comments",
    "web:build": "pnpm --filter @acs/web build",
    "ci:check": "pnpm -r typecheck && pnpm web:build && pnpm check:comments && pnpm --filter @acs/web format:check && pnpm --filter @acs/server validate:templates && pnpm --filter @acs/server probe:ci",
    "probe:all": "pnpm --filter @acs/server probe:all",
    "probe:ci": "pnpm --filter @acs/server probe:ci",
    "validate:templates": "pnpm --filter @acs/server validate:templates",
    "db:generate": "pnpm --filter @acs/server db:generate",
    "db:push": "pnpm --filter @acs/server db:push",
    "package:portable": "pnpm --filter @acs/server package:portable"
  }
}
