# ===== agencys-content-studio 环境变量 =====
# 复制为 .env 使用（.env 不入库）

# 服务端口（默认 3001）
# CSTUDIO_PORT=3001

# Web dev 端口（vite，默认 5273：独占端口，避开 Vite 默认 5173/5174 冲突链）
# CSTUDIO_WEB_PORT=5273

# 工作区/数据目录（默认取仓库根下 workspace/ 与 data/）
# CSTUDIO_WORKSPACE=./workspace
# CSTUDIO_DATA=./data

# 日志级别 debug|info|warn|error
# CSTUDIO_LOG_LEVEL=info

# ===== LLM 网关（ai_text action，OpenAI 兼容 Chat Completions）=====
# 默认复用 AGENT_LLM_* 约定（DeepSeek 网关）；可在平台 Settings 中以
# service_type=llm 的 api_configs 覆盖（is_default=true 时优先）
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-v4-flash-vision-exp

# ===== ffmpeg / ffprobe（合成/封面/时长探测）=====
# 默认使用内置二进制（ffmpeg-static / ffprobe-static，pnpm install 时自动下载）；
# 系统 PATH 次之；如需显式覆盖（优先级最高），取消注释并改为实际路径：
# CSTUDIO_FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# CSTUDIO_FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
