{
  "name": "@acs/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy --watch --env-file-if-exists=../../.env --import tsx src/index.ts",
    "start": "node --use-env-proxy --env-file-if-exists=../../.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "probe:ci": "tsx scripts/run-probes.ts --fail-fast",
    "validate:templates": "tsx scripts/validate-templates.ts",
    "bench": "tsx scripts/bench-stress.ts",
    "model:prepare": "tsx scripts/prepare-embedding-model.ts"
  },
  "dependencies": {
    "@agencys/ai-provider-kit": "https://gitee.com/agencys/ai-provider-kit.git#v0.4.0",
    "@hono/node-server": "^2.1.1",
    "@huggingface/transformers": "^3.8.1",
    "@libsql/client": "^0.18.0",
    "d3-force": "^3.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hono": "^4.13.7",
    "mammoth": "^1.12.3",
    "socket.io": "^4.8.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.5.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
