    "probe:m9": "tsx scripts/probe-m9.ts",
    "probe:m10": "tsx scripts/probe-m10.ts",
    "probe:m11": "tsx scripts/probe-m11.ts",
    "probe:m12": "tsx scripts/probe-m12.ts",
    "probe:m13": "tsx scripts/probe-m13.ts",
    "probe:m14": "tsx scripts/probe-m14.ts",
    "probe:m15": "tsx scripts/probe-m15.ts",
    "probe:m16": "tsx scripts/probe-m16.ts",
