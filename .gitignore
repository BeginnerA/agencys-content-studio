# deps & build
node_modules/
dist/
*.tsbuildinfo

# 便携包产物（含宿主 node.exe 与用户数据，不入库）
dist-portable/

# runtime data（数据库与本地密钥，不入库）
data/

# 运行时产物（项目资产与运行日志由平台生成；brand/ 为平台品牌上传件目录，ensureDirs 自动创建）
workspace/projects/
workspace/logs/
workspace/brand/

# env & secrets
.env
.env.local
secrets.json

# SDD 执行工作区（子代理驱动开发的账本/简报/评审包，git 忽略）
.superpowers/

# misc
*.log
.DS_Store
Thumbs.db
